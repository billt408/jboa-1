//@version=6
indicator(title="RSI 1m Webhook Streamer - Fixed All Bars", shorttitle="All RSI Streamer", overlay=false, format=format.price, precision=2)

// ----------------------------- Inputs -----------------------------
GRP_RSI  = "RSI Configuration"
rsiLen   = input.int(14, "RSI Length", minval=1, group=GRP_RSI)
rsiLow   = input.float(35.0, "Oversold Level (<=)", minval=0.0, maxval=100.0, group=GRP_RSI)
rsiHigh  = input.float(70.0, "Overbought Level (>=)", minval=0.0, maxval=100.0, group=GRP_RSI)

// ----------------------------- Logic -----------------------------
// Enforce 1-minute chart execution boundary
if timeframe.isintraday and timeframe.multiplier != 1
    runtime.error("This script is specifically optimized for a 1-minute chart resolution.")

// Calculate standard 1-minute RSI continuously
rsiLive = ta.rsi(close, rsiLen)

// FIX: Grab the fully completed, non-zero historic calculation from the bar that JUST closed
// This ensures TradingView's alert server sends the real numerical index instead of 0
rsiCompleted = rsiLive

// Trigger an execution step on EVERY single confirmed bar close
rsiTrigger = barstate.isconfirmed

// Maintain visual context flags using the verified historic data index
isOversold   = rsiCompleted <= rsiLow
isOverbought = rsiCompleted >= rsiHigh

// ----------------------------- GUI Plottings -----------------------------
// CRITICAL FIX: This is now explicitly Plot Index 0 ({{plot_0}})
// Expose the raw data to the TradingView alert engine system immediately before any shapes alter indices
plot(rsiCompleted, "RSI Value Plot", display=display.data_window)

// This is now Plot Index 1 ({{plot_1}})
plot(rsiLive, "Live 1m RSI", color=color.purple, linewidth=2)

// Guidelines and background layers
hline(rsiHigh, "Overbought Line", color=color.red, linestyle=hline.style_dashed)
hline(50, "Center Line", color=color.new(color.gray, 50))
hline(rsiLow, "Oversold Line", color=color.green, linestyle=hline.style_dashed)

// Visual shapes for layout auditing
plotshape(rsiTrigger and isOversold, "Oversold State", shape.circle, location.bottom, color=color.green, size=size.tiny)
plotshape(rsiTrigger and isOverbought, "Overbought State", shape.circle, location.top, color=color.red, size=size.tiny)

// Add a tracking check to filter null data points
rsiIsValid = not na(rsiCompleted)

// Create the unified alert condition hook
alertcondition(rsiTrigger and rsiIsValid, "RSI Minute Update", "New 1m Bar Closed with Valid RSI")
