//@version=6
indicator(
     title = "RSI 1m Multi-Symbol Webhook Streamer (27 Symbols)",
     shorttitle = "MultiRSI",
     overlay = false,
     format = format.price,
     precision = 2,
     dynamic_requests = true
)

// ----------------------------- Inputs -----------------------------

GRP_SYMBOLS = "Symbols (1-27)"

enable1 = input.bool(true, "Enable symbol 1", group = GRP_SYMBOLS)
symbol1 = input.symbol("NASDAQ:NVDA", "Symbol 1", group = GRP_SYMBOLS)

enable2 = input.bool(true, "Enable symbol 2", group = GRP_SYMBOLS)
symbol2 = input.symbol("NASDAQ:MU", "Symbol 2", group = GRP_SYMBOLS)

enable3 = input.bool(true, "Enable symbol 3", group = GRP_SYMBOLS)
symbol3 = input.symbol("NASDAQ:CRWV", "Symbol 3", group = GRP_SYMBOLS)

enable4 = input.bool(true, "Enable symbol 4", group = GRP_SYMBOLS)
symbol4 = input.symbol("NASDAQ:SNDK", "Symbol 4", group = GRP_SYMBOLS)

enable5 = input.bool(true, "Enable symbol 5", group = GRP_SYMBOLS)
symbol5 = input.symbol("NYSE:DELL", "Symbol 5", group = GRP_SYMBOLS)

enable6 = input.bool(true, "Enable symbol 6", group = GRP_SYMBOLS)
symbol6 = input.symbol("NYSE:LLY", "Symbol 6", group = GRP_SYMBOLS)

enable7 = input.bool(true, "Enable symbol 7", group = GRP_SYMBOLS)
symbol7 = input.symbol("NYSE:TMO", "Symbol 7", group = GRP_SYMBOLS)

enable8 = input.bool(true, "Enable symbol 8", group = GRP_SYMBOLS)
symbol8 = input.symbol("NASDAQ:ISRG", "Symbol 8", group = GRP_SYMBOLS)

enable9 = input.bool(true, "Enable symbol 9", group = GRP_SYMBOLS)
symbol9 = input.symbol("NASDAQ:VRTX", "Symbol 9", group = GRP_SYMBOLS)

enable10 = input.bool(true, "Enable symbol 10", group = GRP_SYMBOLS)
symbol10 = input.symbol("NYSE:MCD", "Symbol 10", group = GRP_SYMBOLS)

enable11 = input.bool(true, "Enable symbol 11", group = GRP_SYMBOLS)
symbol11 = input.symbol("NYSE:V", "Symbol 11", group = GRP_SYMBOLS)

enable12 = input.bool(true, "Enable symbol 12", group = GRP_SYMBOLS)
symbol12 = input.symbol("NYSE:NOC", "Symbol 12", group = GRP_SYMBOLS)

enable13 = input.bool(true, "Enable symbol 13", group = GRP_SYMBOLS)
symbol13 = input.symbol("NYSE:ROK", "Symbol 13", group = GRP_SYMBOLS)

enable14 = input.bool(true, "Enable symbol 14", group = GRP_SYMBOLS)
symbol14 = input.symbol("NYSE:TSM", "Symbol 14", group = GRP_SYMBOLS)

enable15 = input.bool(true, "Enable symbol 15", group = GRP_SYMBOLS)
symbol15 = input.symbol("NASDAQ:MSFT", "Symbol 15", group = GRP_SYMBOLS)

enable16 = input.bool(true, "Enable symbol 16", group = GRP_SYMBOLS)
symbol16 = input.symbol("NASDAQ:LITE", "Symbol 16", group = GRP_SYMBOLS)

enable17 = input.bool(true, "Enable symbol 17", group = GRP_SYMBOLS)
symbol17 = input.symbol("NASDAQ:META", "Symbol 17", group = GRP_SYMBOLS)

enable18 = input.bool(true, "Enable symbol 18", group = GRP_SYMBOLS)
symbol18 = input.symbol("NASDAQ:AMD", "Symbol 18", group = GRP_SYMBOLS)

enable19 = input.bool(true, "Enable symbol 19", group = GRP_SYMBOLS)
symbol19 = input.symbol("NASDAQ:TSLA", "Symbol 19", group = GRP_SYMBOLS)

enable20 = input.bool(true, "Enable symbol 20", group = GRP_SYMBOLS)
symbol20 = input.symbol("NASDAQ:STX", "Symbol 20", group = GRP_SYMBOLS)

enable21 = input.bool(true, "Enable symbol 21", group = GRP_SYMBOLS)
symbol21 = input.symbol("AMEX:SURE", "Symbol 21", group = GRP_SYMBOLS, tooltip = "(AMEX:SURE ETF on NYSE Arca)")

enable22 = input.bool(true, "Enable symbol 22", group = GRP_SYMBOLS)
symbol22 = input.symbol("NASDAQ:AMZN", "Symbol 22", group = GRP_SYMBOLS)

enable23 = input.bool(true, "Enable symbol 23", group = GRP_SYMBOLS)
symbol23 = input.symbol("NASDAQ:KLAC", "Symbol 23", group = GRP_SYMBOLS)

enable24 = input.bool(true, "Enable symbol 24", group = GRP_SYMBOLS)
symbol24 = input.symbol("NASDAQ:INTC", "Symbol 24", group = GRP_SYMBOLS)

enable25 = input.bool(true, "Enable symbol 25", group = GRP_SYMBOLS)
symbol25 = input.symbol("NASDAQ:SPCX", "Symbol 25", group = GRP_SYMBOLS)

enable26 = input.bool(true, "Enable symbol 26", group = GRP_SYMBOLS)
symbol26 = input.symbol("NASDAQ:AAPL", "Symbol 26", group = GRP_SYMBOLS)

enable27 = input.bool(true, "Enable symbol 27", group = GRP_SYMBOLS)
symbol27 = input.symbol("NASDAQ:GOOG", "Symbol 27", group = GRP_SYMBOLS)

GRP_RSI = "RSI Configuration & Alert Filtering"

rsiLen = input.int(
     14, "RSI Length",
     minval = 1,
     group = GRP_RSI
)

rsiLow = input.float(
     35.0, "Oversold Level (<=)",
     minval = 0.0,
     maxval = 50.0,
     group = GRP_RSI,
     tooltip = "Marks symbol signal as oversold when 1m closed RSI is <= this value."
)

rsiHigh = input.float(
     65.0, "Overbought Level (>=)",
     minval = 50.0,
     maxval = 100.0,
     group = GRP_RSI,
     tooltip = "Marks symbol signal as overbought when 1m closed RSI is >= this value."
)

alertOnlyExtremes = input.bool(
     false,
     "Include ONLY extreme symbols (RSI <= 35 or >= 65)",
     group = GRP_RSI,
     tooltip = "Disabled by default: sends ALL 27 enabled symbols' 1m RSI & price in one consolidated payload every minute. Enable to only include symbols in extreme zones."
)

includeExtended = input.bool(
     false,
     "Include extended-hours bars in RSI history",
     group = GRP_RSI
)

GRP_WEBHOOK = "Webhook Configuration"

sendWebhooks = input.bool(
     true,
     "Enable webhook messages",
     group = GRP_WEBHOOK
)

webhookToken = input.string(
     "",
     "Webhook token  optional",
     group = GRP_WEBHOOK,
     tooltip = "Must match WEBHOOK_TOKEN in Python when authentication is enabled."
)

settleSeconds = input.int(
     2,
     "Wait after source minute ends  seconds",
     minval = 0,
     maxval = 20,
     group = GRP_WEBHOOK
)

maxAgeSeconds = input.int(
     40,
     "Maximum age after source minute ends  seconds",
     minval = 5,
     maxval = 300,
     group = GRP_WEBHOOK
)

// ----------------------------- Validation -----------------------------

if not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("Use this indicator on a standard 1-minute chart.")

if not chart.is_standard
    runtime.error("Use a standard chart, not Heikin Ashi, Renko, or another synthetic chart.")

if maxAgeSeconds <= settleSeconds
    runtime.error("Maximum age must be greater than the wait after minute end.")

allSymbols = array.from(symbol1, symbol2, symbol3, symbol4, symbol5, symbol6, symbol7, symbol8, symbol9, symbol10, symbol11, symbol12, symbol13, symbol14, symbol15, symbol16, symbol17, symbol18, symbol19, symbol20, symbol21, symbol22, symbol23, symbol24, symbol25, symbol26, symbol27)
allEnabled = array.from(enable1, enable2, enable3, enable4, enable5, enable6, enable7, enable8, enable9, enable10, enable11, enable12, enable13, enable14, enable15, enable16, enable17, enable18, enable19, enable20, enable21, enable22, enable23, enable24, enable25, enable26, enable27)

bool duplicateFound = false
for i = 0 to array.size(allSymbols) - 2
    for j = i + 1 to array.size(allSymbols) - 1
        if not duplicateFound and array.get(allEnabled, i) and array.get(allEnabled, j) and array.get(allSymbols, i) == array.get(allSymbols, j)
            duplicateFound := true

if duplicateFound
    runtime.error("Enabled symbols must be unique across all slots.")

// ----------------------------- Persistent state -----------------------------

varip int lastBatchSent = na
varip array<int> lastSent = array.new_int(27, na)

// ----------------------------- Functions -----------------------------

f_sourceValues() =>
    float sourceRsi = ta.rsi(close, rsiLen)
    [
         time,
         time_close,
         close,
         sourceRsi,
         session.ismarket,
         time[1],
         time_close[1],
         close[1],
         sourceRsi[1],
         session.ismarket[1]
    ]

f_completedSample(simple bool enabled, simple string requestedSymbol) =>
    if not enabled or str.length(str.trim(requestedSymbol)) == 0
        [int(na), int(na), float(na), float(na), false]
    else
        string sourceTicker = ticker.modify(
             ticker.standard(requestedSymbol),
             session = includeExtended ? session.extended : session.regular
        )

        [t0, end0, price0, rsi0, regular0,
         t1, end1, price1, rsi1, regular1] = request.security(
             sourceTicker,
             "1",
             f_sourceValues(),
             gaps = barmerge.gaps_off,
             lookahead = barmerge.lookahead_off,
             ignore_invalid_symbol = true
        )

        bool latestHasEnded = (
             not na(end0) and
             end0 + settleSeconds * 1000 <= timenow
        )

        [
             latestHasEnded ? t0 : t1,
             latestHasEnded ? end0 : end1,
             latestHasEnded ? price0 : price1,
             latestHasEnded ? rsi0 : rsi1,
             latestHasEnded ? regular0 : regular1
        ]

f_jsonEscape(string value) =>
    string escaped = str.replace_all(value, "\\", "\\\\")
    escaped := str.replace_all(escaped, "\"", "\\\"")
    escaped := str.replace_all(escaped, "\n", "\\n")
    escaped := str.replace_all(escaped, "\r", "\\r")
    escaped := str.replace_all(escaped, "\t", "\\t")
    escaped

// ----------------------------- Source data (27 Symbols <= 40 security limit) -----------------------------

[t1, e1, p1, r1, g1] = f_completedSample(enable1, symbol1)
[t2, e2, p2, r2, g2] = f_completedSample(enable2, symbol2)
[t3, e3, p3, r3, g3] = f_completedSample(enable3, symbol3)
[t4, e4, p4, r4, g4] = f_completedSample(enable4, symbol4)
[t5, e5, p5, r5, g5] = f_completedSample(enable5, symbol5)
[t6, e6, p6, r6, g6] = f_completedSample(enable6, symbol6)
[t7, e7, p7, r7, g7] = f_completedSample(enable7, symbol7)
[t8, e8, p8, r8, g8] = f_completedSample(enable8, symbol8)
[t9, e9, p9, r9, g9] = f_completedSample(enable9, symbol9)
[t10, e10, p10, r10, g10] = f_completedSample(enable10, symbol10)
[t11, e11, p11, r11, g11] = f_completedSample(enable11, symbol11)
[t12, e12, p12, r12, g12] = f_completedSample(enable12, symbol12)
[t13, e13, p13, r13, g13] = f_completedSample(enable13, symbol13)
[t14, e14, p14, r14, g14] = f_completedSample(enable14, symbol14)
[t15, e15, p15, r15, g15] = f_completedSample(enable15, symbol15)
[t16, e16, p16, r16, g16] = f_completedSample(enable16, symbol16)
[t17, e17, p17, r17, g17] = f_completedSample(enable17, symbol17)
[t18, e18, p18, r18, g18] = f_completedSample(enable18, symbol18)
[t19, e19, p19, r19, g19] = f_completedSample(enable19, symbol19)
[t20, e20, p20, r20, g20] = f_completedSample(enable20, symbol20)
[t21, e21, p21, r21, g21] = f_completedSample(enable21, symbol21)
[t22, e22, p22, r22, g22] = f_completedSample(enable22, symbol22)
[t23, e23, p23, r23, g23] = f_completedSample(enable23, symbol23)
[t24, e24, p24, r24, g24] = f_completedSample(enable24, symbol24)
[t25, e25, p25, r25, g25] = f_completedSample(enable25, symbol25)
[t26, e26, p26, r26, g26] = f_completedSample(enable26, symbol26)
[t27, e27, p27, r27, g27] = f_completedSample(enable27, symbol27)

allT = array.from(t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15, t16, t17, t18, t19, t20, t21, t22, t23, t24, t25, t26, t27)
allE = array.from(e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16, e17, e18, e19, e20, e21, e22, e23, e24, e25, e26, e27)
allP = array.from(p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16, p17, p18, p19, p20, p21, p22, p23, p24, p25, p26, p27)
allR = array.from(r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15, r16, r17, r18, r19, r20, r21, r22, r23, r24, r25, r26, r27)
allG = array.from(g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15, g16, g17, g18, g19, g20, g21, g22, g23, g24, g25, g26, g27)

// ----------------------------- Single Batch Webhook Dispatch (1 Payload / Minute) -----------------------------

eligible = array.new_bool(27, false)
int batchBarStart = na
bool batchDispatched = false

if sendWebhooks and barstate.isrealtime
    // Pass 1: find all valid symbols settled inside the 1-minute dispatch window
    for i = 0 to 26
        bool isEnabled = array.get(allEnabled, i)
        int barStart = array.get(allT, i)
        int barEnd = array.get(allE, i)
        float barPrice = array.get(allP, i)
        float barRsi = array.get(allR, i)
        bool isRegular = array.get(allG, i)
        int prevSlotMinute = array.get(lastSent, i)

        bool baseValid = (
             isEnabled and
             isRegular and
             not na(barStart) and
             not na(barEnd) and
             not na(barPrice) and
             not na(barRsi) and
             barPrice > 0
        )

        if baseValid
            int ageMs = timenow - barEnd
            bool insideWindow = ageMs >= settleSeconds * 1000 and ageMs <= maxAgeSeconds * 1000
            bool newForSlot = na(prevSlotMinute) or barStart > prevSlotMinute
            bool extremeOk = not alertOnlyExtremes or (barRsi <= rsiLow or barRsi >= rsiHigh)

            if insideWindow and newForSlot and extremeOk
                array.set(eligible, i, true)
                if na(batchBarStart) or barStart > batchBarStart
                    batchBarStart := barStart

    // Pass 2: assemble 1 consolidated JSON payload and fire alert() once per minute
    if not na(batchBarStart) and (na(lastBatchSent) or batchBarStart > lastBatchSent)
        batchItems = array.new_string()
        string batchTimestamp = str.format_time(batchBarStart, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC+0")

        for i = 0 to 26
            if array.get(eligible, i)
                string sym = array.get(allSymbols, i)
                int barStart = array.get(allT, i)
                float barPrice = array.get(allP, i)
                float barRsi = array.get(allR, i)

                bool isOversold = barRsi <= rsiLow
                bool isOverbought = barRsi >= rsiHigh
                string signalType = isOversold ? "oversold" : isOverbought ? "overbought" : "neutral"

                string itemJson = (
                     "{\"ticker\":\"" + f_jsonEscape(sym) + "\"" +
                     ",\"signal\":\"" + signalType + "\"" +
                     ",\"rsi_value\":" + str.tostring(barRsi, "#.##") +
                     ",\"price\":" + str.tostring(barPrice, "#.##")
                )

                if isOversold or isOverbought
                    float thresholdUsed = isOversold ? rsiLow : rsiHigh
                    itemJson := itemJson + ",\"threshold_used\":" + str.tostring(thresholdUsed, "#.##")

                if barStart != batchBarStart
                    string itemTs = str.format_time(barStart, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC+0")
                    itemJson := itemJson + ",\"bar_start\":\"" + itemTs + "\""

                itemJson := itemJson + "}"

                array.push(batchItems, itemJson)
                array.set(lastSent, i, barStart)

        if array.size(batchItems) > 0
            string batchMessage = (
                 "{\"event\":\"rsi_batch\"" +
                 ",\"timeframe\":\"1m\"" +
                 ",\"bar_start\":\"" + batchTimestamp + "\"" +
                 ",\"bar_closed\":true" +
                 ",\"count\":" + str.tostring(array.size(batchItems))
            )

            if str.length(webhookToken) > 0
                batchMessage := batchMessage + ",\"webhook_token\":\"" + f_jsonEscape(webhookToken) + "\""

            batchMessage := batchMessage + ",\"data\":[" + array.join(batchItems, ",") + "]}"

            // Single consolidated webhook alert once per minute for all enabled symbols
            alert(batchMessage, alert.freq_all)
            lastBatchSent := batchBarStart
            batchDispatched := true

// ----------------------------- Display & Guidelines -----------------------------

plot(enable1 ? r1 : na, "Symbol 1 RSI", color = color.purple, linewidth = 2)
plot(enable2 ? r2 : na, "Symbol 2 RSI", color = color.blue, linewidth = 2)
plot(enable3 ? r3 : na, "Symbol 3 RSI", color = color.orange, linewidth = 2)

hTop = hline(100, "Top 100", color = color.new(color.gray, 100))
hHigh = hline(rsiHigh, "Overbought (>= 65)", color = color.red, linestyle = hline.style_dashed, linewidth = 1)
hMid = hline(50, "Center 50", color = color.new(color.gray, 60))
hLow = hline(rsiLow, "Oversold (<= 35)", color = color.green, linestyle = hline.style_dashed, linewidth = 1)
hBot = hline(0, "Bottom 0", color = color.new(color.gray, 100))

fill(hHigh, hTop, color = color.new(color.red, 90), title = "Overbought Zone")
fill(hBot, hLow, color = color.new(color.green, 90), title = "Oversold Zone")

plotshape(batchDispatched, title = "Batch webhook dispatched", style = shape.circle, location = location.bottom, color = color.lime, size = size.tiny)
