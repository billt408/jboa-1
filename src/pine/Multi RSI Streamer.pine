//@version=6
indicator(
     title = "RSI 1m Multi-Symbol Webhook Streamer",
     shorttitle = "MultiRSI",
     overlay = false,
     format = format.price,
     precision = 2,
     dynamic_requests = true
)

// ----------------------------- Inputs -----------------------------

GRP_SYMBOLS = "Symbols"
GRP_EXTRA = "Additional Symbols"

enable1 = input.bool(true, "Enable symbol 1", group = GRP_SYMBOLS)
symbol1 = input.symbol("NASDAQ:NVDA", "Symbol 1", group = GRP_SYMBOLS)

enable2 = input.bool(true, "Enable symbol 2", group = GRP_SYMBOLS)
symbol2 = input.symbol("NASDAQ:MU", "Symbol 2", group = GRP_SYMBOLS)

enable3 = input.bool(true, "Enable symbol 3", group = GRP_SYMBOLS)
symbol3 = input.symbol("NASDAQ:CRWV", "Symbol 3", group = GRP_SYMBOLS)

enable4 = input.bool(true, "Enable symbol 4", group = GRP_EXTRA)
symbol4 = input.symbol("NASDAQ:SNDK", "Symbol 4", group = GRP_EXTRA)

enable5 = input.bool(true, "Enable symbol 5", group = GRP_EXTRA)
symbol5 = input.symbol("NYSE:DELL", "Symbol 5", group = GRP_EXTRA)

enable6 = input.bool(true, "Enable symbol 6", group = GRP_EXTRA)
symbol6 = input.symbol("NYSE:LLY", "Symbol 6", group = GRP_EXTRA)

enable7 = input.bool(true, "Enable symbol 7", group = GRP_EXTRA)
symbol7 = input.symbol("NYSE:TMO", "Symbol 7", group = GRP_EXTRA)

enable8 = input.bool(true, "Enable symbol 8", group = GRP_EXTRA)
symbol8 = input.symbol("NASDAQ:ISRG", "Symbol 8", group = GRP_EXTRA)

enable9 = input.bool(true, "Enable symbol 9", group = GRP_EXTRA)
symbol9 = input.symbol("NASDAQ:VRTX", "Symbol 9", group = GRP_EXTRA)

enable10 = input.bool(true, "Enable symbol 10", group = GRP_EXTRA)
symbol10 = input.symbol("NYSE:MCD", "Symbol 10", group = GRP_EXTRA)

enable11 = input.bool(true, "Enable symbol 11", group = GRP_EXTRA)
symbol11 = input.symbol("NYSE:V", "Symbol 11", group = GRP_EXTRA)

enable12 = input.bool(true, "Enable symbol 12", group = GRP_EXTRA)
symbol12 = input.symbol("NYSE:NOC", "Symbol 12", group = GRP_EXTRA)

enable13 = input.bool(true, "Enable symbol 13", group = GRP_EXTRA)
symbol13 = input.symbol("NYSE:ROK", "Symbol 13", group = GRP_EXTRA)

enable14 = input.bool(true, "Enable symbol 14", group = GRP_EXTRA)
symbol14 = input.symbol("NYSE:TSM", "Symbol 14", group = GRP_EXTRA)

enable15 = input.bool(true, "Enable symbol 15", group = GRP_EXTRA)
symbol15 = input.symbol("NASDAQ:MSFT", "Symbol 15", group = GRP_EXTRA)

enable16 = input.bool(true, "Enable symbol 16", group = GRP_EXTRA)
symbol16 = input.symbol("NASDAQ:LITE", "Symbol 16", group = GRP_EXTRA)

enable17 = input.bool(true, "Enable symbol 17", group = GRP_EXTRA)
symbol17 = input.symbol("NASDAQ:META", "Symbol 17", group = GRP_EXTRA)

enable18 = input.bool(true, "Enable symbol 18", group = GRP_EXTRA)
symbol18 = input.symbol("NASDAQ:AMD", "Symbol 18", group = GRP_EXTRA)

enable19 = input.bool(true, "Enable symbol 19", group = GRP_EXTRA)
symbol19 = input.symbol("NASDAQ:TSLA", "Symbol 19", group = GRP_EXTRA)

enable20 = input.bool(true, "Enable symbol 20", group = GRP_EXTRA)
symbol20 = input.symbol("NASDAQ:STX", "Symbol 20", group = GRP_EXTRA)

enable21 = input.bool(true, "Enable symbol 21", group = GRP_EXTRA)
symbol21 = input.symbol("AMEX:SURE", "Symbol 21", group = GRP_EXTRA, tooltip = "(21: AMEX:SURE is the AdvisorShares Insider Advantage ETF on NYSE Arca)")

GRP_RSI = "RSI Configuration & Alert Filtering"

rsiLen = input.int(
     14, "RSI Length",
     minval = 1,
     group = GRP_RSI
)

rsiLow = input.float(
     35.0, "Oversold Level (<=)",
     minval = 0.0,
     maxval = 50.0,
     group = GRP_RSI,
     tooltip = "Alert triggers when a symbol's 1m closed RSI is <= this value."
)

rsiHigh = input.float(
     65.0, "Overbought Level (>=)",
     minval = 50.0,
     maxval = 100.0,
     group = GRP_RSI,
     tooltip = "Alert triggers when a symbol's 1m closed RSI is >= this value."
)

alertOnlyExtremes = input.bool(
     true,
     "Alert ONLY on RSI <= 35 or >= 65",
     group = GRP_RSI,
     tooltip = "Critical: Prevents 'Alert triggered too often' by skipping neutral bars (35 < RSI < 65) and only alerting on extreme conditions."
)

includeExtended = input.bool(
     false,
     "Include extended-hours bars in RSI history",
     group = GRP_RSI
)

GRP_WEBHOOK = "Webhook Configuration"

sendWebhooks = input.bool(
     true,
     "Enable webhook messages",
     group = GRP_WEBHOOK
)

webhookToken = input.string(
     "",
     "Webhook token  optional",
     group = GRP_WEBHOOK,
     tooltip = "Must match WEBHOOK_TOKEN in Python when authentication is enabled."
)

settleSeconds = input.int(
     2,
     "Wait after source minute ends  seconds",
     minval = 0,
     maxval = 20,
     group = GRP_WEBHOOK
)

maxAgeSeconds = input.int(
     40,
     "Maximum age after source minute ends  seconds",
     minval = 5,
     maxval = 300,
     group = GRP_WEBHOOK
)

// ----------------------------- Validation -----------------------------

if not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("Use this indicator on a standard 1-minute chart.")

if not chart.is_standard
    runtime.error("Use a standard chart, not Heikin Ashi, Renko, or another synthetic chart.")

if maxAgeSeconds <= settleSeconds
    runtime.error("Maximum age must be greater than the wait after minute end.")

allSymbols = array.from(symbol1, symbol2, symbol3, symbol4, symbol5, symbol6, symbol7, symbol8, symbol9, symbol10, symbol11, symbol12, symbol13, symbol14, symbol15, symbol16, symbol17, symbol18, symbol19, symbol20, symbol21)
allEnabled = array.from(enable1, enable2, enable3, enable4, enable5, enable6, enable7, enable8, enable9, enable10, enable11, enable12, enable13, enable14, enable15, enable16, enable17, enable18, enable19, enable20, enable21)

bool duplicateFound = false
for i = 0 to array.size(allSymbols) - 2
    for j = i + 1 to array.size(allSymbols) - 1
        if not duplicateFound and array.get(allEnabled, i) and array.get(allEnabled, j) and array.get(allSymbols, i) == array.get(allSymbols, j)
            duplicateFound := true

if duplicateFound
    runtime.error("Enabled symbols must be unique across all slots.")

// ----------------------------- Persistent state -----------------------------

varip array<int> lastSent = array.new_int(21, na)

// ----------------------------- Functions -----------------------------

f_sourceValues() =>
    float sourceRsi = ta.rsi(close, rsiLen)
    [
         time,
         time_close,
         close,
         sourceRsi,
         session.ismarket,
         time[1],
         time_close[1],
         close[1],
         sourceRsi[1],
         session.ismarket[1]
    ]

f_completedSample(simple string requestedSymbol) =>
    string sourceTicker = ticker.modify(
         ticker.standard(requestedSymbol),
         session = includeExtended ? session.extended : session.regular
    )

    [t0, end0, price0, rsi0, regular0,
     t1, end1, price1, rsi1, regular1] = request.security(
         sourceTicker,
         "1",
         f_sourceValues(),
         gaps = barmerge.gaps_off,
         lookahead = barmerge.lookahead_off,
         ignore_invalid_symbol = true
    )

    bool latestHasEnded = (
         not na(end0) and
         end0 + settleSeconds * 1000 <= timenow
    )

    [
         latestHasEnded ? t0 : t1,
         latestHasEnded ? end0 : end1,
         latestHasEnded ? price0 : price1,
         latestHasEnded ? rsi0 : rsi1,
         latestHasEnded ? regular0 : regular1
    ]

f_jsonEscape(string value) =>
    string escaped = str.replace_all(value, "\\", "\\\\")
    escaped := str.replace_all(escaped, "\"", "\\\"")
    escaped := str.replace_all(escaped, "\n", "\\n")
    escaped := str.replace_all(escaped, "\r", "\\r")
    escaped := str.replace_all(escaped, "\t", "\\t")
    escaped

f_payload(
     string requestedSymbol,
     int barStart,
     float barPrice,
     float barRsi
 ) =>
    string timestamp = str.format_time(
         barStart,
         "yyyy-MM-dd'T'HH:mm:ss'Z'",
         "UTC+0"
    )

    bool isOversold = barRsi <= rsiLow
    string signalType = isOversold ? "oversold" : "overbought"
    float thresholdUsed = isOversold ? rsiLow : rsiHigh

    string message = (
         "{\"ticker\":\"" + f_jsonEscape(requestedSymbol) + "\"" +
         ",\"signal\":\"" + signalType + "\"" +
         ",\"rsi_value\":" + str.tostring(barRsi, "#.##") +
         ",\"price\":" + str.tostring(barPrice, "#.##") +
         ",\"timeframe\":\"1m\"" +
         ",\"bar_start\":\"" + timestamp + "\"" +
         ",\"bar_closed\":true" +
         ",\"threshold_used\":" + str.tostring(thresholdUsed, "#.##")
    )

    if str.length(webhookToken) > 0
        message := (
             message +
             ",\"webhook_token\":\"" +
             f_jsonEscape(webhookToken) +
             "\""
        )

    message + "}"

f_send(
     bool enabled,
     int slot,
     string requestedSymbol,
     int barStart,
     int barEnd,
     float barPrice,
     float barRsi,
     bool isRegular
 ) =>
    bool sent = false

    // STRICT CONDITION: Only alert when RSI <= 35 or >= 65
    // Do NOT alert if RSI is between 35 and 65 (35 < RSI < 65)
    bool isOversold = not na(barRsi) and barRsi <= rsiLow
    bool isOverbought = not na(barRsi) and barRsi >= rsiHigh
    bool inExtremeZone = isOversold or isOverbought

    bool valid = (
         enabled and
         sendWebhooks and
         barstate.isrealtime and
         isRegular and
         not na(barStart) and
         not na(barEnd) and
         not na(barPrice) and
         not na(barRsi) and
         barPrice > 0 and
         inExtremeZone
    )

    if valid
        int ageMs = timenow - barEnd
        int previousMinute = array.get(lastSent, slot)

        bool insideWindow = (
             ageMs >= settleSeconds * 1000 and
             ageMs <= maxAgeSeconds * 1000
        )

        bool newMinute = (
             na(previousMinute) or
             barStart > previousMinute
        )

        if insideWindow and newMinute
            string message = f_payload(
                 requestedSymbol,
                 barStart,
                 barPrice,
                 barRsi
            )

            // Dispatches only when RSI <= 35 or >= 65
            alert(message, alert.freq_all)

            array.set(lastSent, slot, barStart)
            sent := true

    sent

// ----------------------------- Source data (21 Symbols) -----------------------------

[t1, e1, p1, r1, g1] = f_completedSample(symbol1)
[t2, e2, p2, r2, g2] = f_completedSample(symbol2)
[t3, e3, p3, r3, g3] = f_completedSample(symbol3)
[t4, e4, p4, r4, g4] = f_completedSample(symbol4)
[t5, e5, p5, r5, g5] = f_completedSample(symbol5)
[t6, e6, p6, r6, g6] = f_completedSample(symbol6)
[t7, e7, p7, r7, g7] = f_completedSample(symbol7)
[t8, e8, p8, r8, g8] = f_completedSample(symbol8)
[t9, e9, p9, r9, g9] = f_completedSample(symbol9)
[t10, e10, p10, r10, g10] = f_completedSample(symbol10)
[t11, e11, p11, r11, g11] = f_completedSample(symbol11)
[t12, e12, p12, r12, g12] = f_completedSample(symbol12)
[t13, e13, p13, r13, g13] = f_completedSample(symbol13)
[t14, e14, p14, r14, g14] = f_completedSample(symbol14)
[t15, e15, p15, r15, g15] = f_completedSample(symbol15)
[t16, e16, p16, r16, g16] = f_completedSample(symbol16)
[t17, e17, p17, r17, g17] = f_completedSample(symbol17)
[t18, e18, p18, r18, g18] = f_completedSample(symbol18)
[t19, e19, p19, r19, g19] = f_completedSample(symbol19)
[t20, e20, p20, r20, g20] = f_completedSample(symbol20)
[t21, e21, p21, r21, g21] = f_completedSample(symbol21)

// ----------------------------- Webhook dispatch -----------------------------

sent1 = f_send(enable1, 0, symbol1, t1, e1, p1, r1, g1)
sent2 = f_send(enable2, 1, symbol2, t2, e2, p2, r2, g2)
sent3 = f_send(enable3, 2, symbol3, t3, e3, p3, r3, g3)
sent4 = f_send(enable4, 3, symbol4, t4, e4, p4, r4, g4)
sent5 = f_send(enable5, 4, symbol5, t5, e5, p5, r5, g5)
sent6 = f_send(enable6, 5, symbol6, t6, e6, p6, r6, g6)
sent7 = f_send(enable7, 6, symbol7, t7, e7, p7, r7, g7)
sent8 = f_send(enable8, 7, symbol8, t8, e8, p8, r8, g8)
sent9 = f_send(enable9, 8, symbol9, t9, e9, p9, r9, g9)
sent10 = f_send(enable10, 9, symbol10, t10, e10, p10, r10, g10)
sent11 = f_send(enable11, 10, symbol11, t11, e11, p11, r11, g11)
sent12 = f_send(enable12, 11, symbol12, t12, e12, p12, r12, g12)
sent13 = f_send(enable13, 12, symbol13, t13, e13, p13, r13, g13)
sent14 = f_send(enable14, 13, symbol14, t14, e14, p14, r14, g14)
sent15 = f_send(enable15, 14, symbol15, t15, e15, p15, r15, g15)
sent16 = f_send(enable16, 15, symbol16, t16, e16, p16, r16, g16)
sent17 = f_send(enable17, 16, symbol17, t17, e17, p17, r17, g17)
sent18 = f_send(enable18, 17, symbol18, t18, e18, p18, r18, g18)
sent19 = f_send(enable19, 18, symbol19, t19, e19, p19, r19, g19)
sent20 = f_send(enable20, 19, symbol20, t20, e20, p20, r20, g20)
sent21 = f_send(enable21, 20, symbol21, t21, e21, p21, r21, g21)

// ----------------------------- Display & Guidelines -----------------------------

plot(enable1 ? r1 : na, "Symbol 1 RSI", color = color.purple, linewidth = 2)
plot(enable2 ? r2 : na, "Symbol 2 RSI", color = color.blue, linewidth = 2)
plot(enable3 ? r3 : na, "Symbol 3 RSI", color = color.orange, linewidth = 2)

hTop = hline(100, "Top 100", color = color.new(color.gray, 100))
hHigh = hline(rsiHigh, "Overbought (>= 65)", color = color.red, linestyle = hline.style_dashed, linewidth = 1)
hMid = hline(50, "Center 50", color = color.new(color.gray, 60))
hLow = hline(rsiLow, "Oversold (<= 35)", color = color.green, linestyle = hline.style_dashed, linewidth = 1)
hBot = hline(0, "Bottom 0", color = color.new(color.gray, 100))

fill(hHigh, hTop, color = color.new(color.red, 90), title = "Overbought Zone")
fill(hBot, hLow, color = color.new(color.green, 90), title = "Oversold Zone")

// Webhook dispatch markers
plotshape(sent1, title = "Symbol 1 webhook", style = shape.circle, location = location.bottom, color = color.purple, size = size.tiny)
plotshape(sent2, title = "Symbol 2 webhook", style = shape.circle, location = location.bottom, color = color.blue, size = size.tiny)
plotshape(sent3, title = "Symbol 3 webhook", style = shape.circle, location = location.bottom, color = color.orange, size = size.tiny)
plotshape(sent4, title = "Symbol 4 webhook", style = shape.circle, location = location.bottom, color = color.teal, size = size.tiny)
plotshape(sent5, title = "Symbol 5 webhook", style = shape.circle, location = location.bottom, color = color.fuchsia, size = size.tiny)
plotshape(sent6, title = "Symbol 6 webhook", style = shape.circle, location = location.bottom, color = color.olive, size = size.tiny)
plotshape(sent7, title = "Symbol 7 webhook", style = shape.circle, location = location.bottom, color = color.aqua, size = size.tiny)
plotshape(sent8, title = "Symbol 8 webhook", style = shape.circle, location = location.bottom, color = color.lime, size = size.tiny)
plotshape(sent9, title = "Symbol 9 webhook", style = shape.circle, location = location.bottom, color = color.yellow, size = size.tiny)
plotshape(sent10, title = "Symbol 10 webhook", style = shape.circle, location = location.bottom, color = color.maroon, size = size.tiny)
plotshape(sent11, title = "Symbol 11 webhook", style = shape.circle, location = location.bottom, color = color.navy, size = size.tiny)
plotshape(sent12, title = "Symbol 12 webhook", style = shape.circle, location = location.bottom, color = color.red, size = size.tiny)
plotshape(sent13, title = "Symbol 13 webhook", style = shape.circle, location = location.bottom, color = color.green, size = size.tiny)
plotshape(sent14, title = "Symbol 14 webhook", style = shape.circle, location = location.bottom, color = color.gray, size = size.tiny)
plotshape(sent15, title = "Symbol 15 webhook", style = shape.circle, location = location.bottom, color = color.black, size = size.tiny)
plotshape(sent16, title = "Symbol 16 webhook", style = shape.circle, location = location.bottom, color = color.white, size = size.tiny)
plotshape(sent17, title = "Symbol 17 webhook", style = shape.circle, location = location.bottom, color = color.rgb(160, 82, 45), size = size.tiny)
plotshape(sent18, title = "Symbol 18 webhook", style = shape.circle, location = location.bottom, color = color.purple, size = size.tiny)
plotshape(sent19, title = "Symbol 19 webhook", style = shape.circle, location = location.bottom, color = color.blue, size = size.tiny)
plotshape(sent20, title = "Symbol 20 webhook", style = shape.circle, location = location.bottom, color = color.orange, size = size.tiny)
