//@version=6
indicator(title="RSI 1m Webhook Streamer - Manual Math", shorttitle="RSI Streamer Fixed", overlay=false, format=format.price, precision=2)

// ----------------------------- Inputs -----------------------------
GRP_RSI  = "RSI Configuration"
rsiLen   = input.int(14, "RSI Length", minval=1, group=GRP_RSI)

// ----------------------------- Manual RSI Calculation Loop -----------------------------
// We calculate Wilder's RMA manually using persistent memory arrays to ensure non-zero alert states
alpha = 1.0 / rsiLen
diff  = ta.change(close)

var float rmaUp = na
var float rmaDown = na

// Calculate smooth upward and downward change components
upChg   = math.max(diff, 0.0)
downChg = -math.min(diff, 0.0)

rmaUp   := na(rmaUp[1])   ? ta.sma(upChg, rsiLen)   : alpha * upChg + (1.0 - alpha) * rmaUp[1]
rmaDown := na(rmaDown[1]) ? ta.sma(downChg, rsiLen) : alpha * downChg + (1.0 - alpha) * rmaDown[1]

// Explicitly calculate the exact manual RSI float index
rs = rmaDown == 0.0 ? na : rmaUp / rmaDown
rsiManual = rmaDown == 0.0 ? 100.0 : na(rs) ? 50.0 : 100.0 - (100.0 / (1.0 + rs))

// Ensure a hard latch of the completed historic bar value to push to the webhook alert engine
var float rsiStreamValue = 50.0
if barstate.isconfirmed
    rsiStreamValue := rsiManual

// Trigger step on every single bar completion frame
rsiTrigger = barstate.isconfirmed

// ----------------------------- GUI & Data Export -----------------------------
// This is the absolute first plot array assignment in the script engine
plot(rsiManual, "RSI Stream Output", color=color.purple, linewidth=2)
hline(70, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(30, "Oversold", color=color.green, linestyle=hline.style_dashed)

// Create the unified alert construct hook
alertcondition(rsiTrigger, "RSI Minute Update", "New 1m Bar Closed")
